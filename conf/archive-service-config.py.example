# Example config file, copy to conf/archive-service-config.py or point
# ARCHIVE_CONFIG at your own file. Settings here override the environment,
# leave out (or comment) anything you want to keep from the defaults/env.
# See README.md for all settings.

# ARCHIVE_TZ = "Europe/Stockholm"
