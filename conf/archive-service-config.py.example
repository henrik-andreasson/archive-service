# ARCHIVE_IPS_HEALTH = ["127.0.0.1"]
# ARCHIVE_ALLOW_REMOVE = False
# ARCHIVE_DEBUG = False
# ARCHIVE_UI = False
# ARCHIVE_MAX_UPLOAD_MB = 1024
